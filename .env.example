# Copier ce fichier en ".env" (non versionné) et remplir les valeurs réelles.
# Ce sont les identifiants de la NOUVELLE base/utilisateur à créer dans le
# conteneur MySQL existant ("bdd-mysql") pour les Foulées du 12 — pas ceux
# des autres apps (SAM Paris 12, Finance, disques) sur ce même conteneur.

FOULEES12_DB_NAME=foulees12db
FOULEES12_DB_USER=Foulees12Admin
FOULEES12_DB_PASSWORD=

# URL publique du frontend (utilisée pour l'en-tête CORS du backend)
FRONTEND_URL=https://foulees.samparis12.org
